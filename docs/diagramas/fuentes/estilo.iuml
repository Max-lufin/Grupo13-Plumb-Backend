' Estilo común de los diagramas de secuencia de Plumb (escala de grises, para el informe)
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Carlito
skinparam defaultFontSize 14
skinparam defaultFontColor #1A1A1A
skinparam shadowing false
skinparam roundCorner 6
skinparam ArrowColor #1A1A1A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 13
skinparam ArrowFontColor #1A1A1A
skinparam note {
  BackgroundColor #F2F2F2
  BorderColor #808080
  FontSize 12
}
skinparam sequence {
  LifeLineBorderColor #A6A6A6
  LifeLineBackgroundColor #E6E6E6
  ParticipantBorderColor #1A1A1A
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontStyle bold
  ActorBorderColor #1A1A1A
  ActorBackgroundColor #D9D9D9
  DatabaseBorderColor #1A1A1A
  DatabaseBackgroundColor #E6E6E6
  GroupBorderColor #4D4D4D
  GroupBackgroundColor #E6E6E6
  GroupHeaderFontColor #1A1A1A
  DividerBackgroundColor #F2F2F2
  DividerBorderColor #BFBFBF
  ReferenceBackgroundColor #F2F2F2
  MessageAlign left
}
skinparam ParticipantPadding 12
skinparam BoxPadding 8
autonumber "<b>0"
hide footbox
