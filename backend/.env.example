# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# MongoDB.
#   Local (Docker):  mongodb://localhost:27019/?directConnection=true
#   Atlas:           mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=plumb

# Secreto con que se firman los tokens de sesión (JWT). Una cadena larga y aleatoria,
# por ejemplo la salida de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio en producción; en desarrollo, si falta, se genera uno al arrancar.
SESION_SECRETO=

# Puerto local de la API (en Vercel no se usa).
PORT=3000

# Orígenes que pueden llamar a la API (separados por coma).
CORS_ORIGINS=http://localhost:5173
