# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# Cadena de conexión a PostgreSQL.
#   Local (Docker):  postgresql://plumb:plumb@localhost:54329/plumb
#   Neon:            postgresql://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Puerto local de la API (en Vercel no se usa).
PORT=3000

# Orígenes que pueden llamar a la API (separados por coma).
CORS_ORIGINS=http://localhost:5173

# MongoDB (modelo de documentos, Etapa 2).
#   Local (Docker):  mongodb://localhost:27019/?directConnection=true
#   Atlas:           mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=plumb
